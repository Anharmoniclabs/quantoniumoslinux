prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: rftmw
Description: High-performance RFTMW transform and compression library (patent-practicing)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lrftmw
Cflags: -I${includedir}
