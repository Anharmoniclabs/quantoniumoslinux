{
  "schema_version": "smartweights/v1",
  "name": "Eldrae ImageGen SmartWeights",
  "version": "0.1.0",
  "kind": "knowledge_snapshot",
  "created_at": "2026-04-20T00:00:00+00:00",
  "identity": {
    "assistant": "Eldrae",
    "role": "image generation orchestrator"
  },
  "base": {
    "runtime_model": "qwen2.5-coder:3b",
    "training_model": "Qwen/Qwen2.5-Coder-3B-Instruct",
    "frozen": true
  },
  "rft_space": {
    "family": "RFTMW",
    "encoding": "prompt_overlay",
    "base_tensor_mutation": "none"
  },
  "artifacts": [
    {
      "path": "smartweights/packs/eldrae-imagegen/system_prompt_enhancement.md",
      "optional": false,
      "present": true,
      "kind": "prompt_overlay"
    },
    {
      "path": "smartweights/packs/eldrae-imagegen/training_profile_resonart_lora.yaml",
      "optional": false,
      "present": true,
      "kind": "training_profile"
    }
  ],
  "training": {
    "datasets": [],
    "reports": [],
    "guardrails": "image gen prompts must be safe, descriptive, and reproducible",
    "pipeline": {
      "prepare": "scripts/ai/prepare_resonart_lora_dataset.py",
      "train": "scripts/ai/train_resonart_lora.py",
      "infer": "scripts/ai/infer_resonart_lora.py"
    },
    "quality_target": "512-cpu"
  },
  "capabilities": [
    "image_generation",
    "spectral_prompt_synthesis",
    "visual_scene_description",
    "style_transfer_guidance",
    "negative_prompt_engineering"
  ],
  "backends": {
    "local": {
      "engine": "resonart",
      "type": "spectral_synthesis",
      "implementation": "src/resonart/engine.py",
      "notes": "Genuine on-device image engine: semantic procedural rendering, supersampled composition, NumPy+PIL, CPU-only, zero cloud"
    },
    "fallback": "none"
  },
  "safety": {
    "base_weight_mutation": "forbidden",
    "loads_as_overlay": true,
    "requires_manifest_validation": true,
    "destructive_actions": "forbidden",
    "network_access": "off_by_default",
    "content_filter": "nsfw_blocked",
    "allowed_write_roots": [
      "smartweights/packs",
      "generated/images",
      "logs"
    ]
  },
  "notes": "Image generation overlay. Teaches Eldrae to craft strong image prompts and interface with the local Resonart engine."
}
