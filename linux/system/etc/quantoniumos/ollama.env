# Ollama settings for QuantoniumOS, read by qos-desktop when it starts Ollama as an
# RFTMW workload. Per-user overrides go in ~/.config/quantoniumos/ollama.env;
# variables already set in the environment take precedence over both files.

# Flash attention: less memory traffic per token on CPU, and required for the
# quantised KV cache below.
OLLAMA_FLASH_ATTENTION=1
# 8-bit KV cache: half the memory of f16 for the same context length, with
# negligible quality loss (q4_0 halves it again at a visible cost).
OLLAMA_KV_CACHE_TYPE=q8_0
# One resident model: on a RAM-bound desktop a second model only evicts the first.
OLLAMA_MAX_LOADED_MODELS=1
# Keep the model mapped between chats instead of reloading after 5 minutes. Its
# weights are file-backed, so the kernel can still reclaim them under pressure.
OLLAMA_KEEP_ALIVE=30m
