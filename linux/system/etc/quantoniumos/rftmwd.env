# System-wide rftmwd options; per-user overrides go in ~/.config/quantoniumos/rftmwd.env.
#   --pack-budget-mb MB    cap on page-cache bytes held by brokered packs (0 = unlimited)
#   --psi-threshold PCT    some-avg10 trigger used only when PSI triggers are unavailable
#   --pressure-idle-s S    packs idle this long are eligible for pressure eviction
RFTMWD_ARGS=--pressure-idle-s 30
